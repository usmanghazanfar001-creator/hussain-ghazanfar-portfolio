# Copy this file to .env (local) and set the same names in Vercel > Settings > Environment Variables.

# REQUIRED before launch: your real production domain, no trailing slash.
# Used for canonical URLs, Open Graph, structured data, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.example.com

# OPTIONAL: Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty to disable analytics entirely.
VITE_GA_ID=

# OPTIONAL: Bing Webmaster Tools verification code (the content value of the msvalidate.01 meta tag).
VITE_BING_VERIFICATION=
